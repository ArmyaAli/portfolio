---
import ExperienceLayout from "../layouts/ExperienceLayout.astro";
import StationDialog from "../components/experience/StationDialog.astro";
import { site } from "../config";
import { stations } from "../experience/stations";
import type { ResumeDocument } from "../lib/resume/types";
import parsed from "../data/resume.generated.json";

const resume = parsed as ResumeDocument;
const role = "Software Engineer";
const location = resume.experience[0]?.location ?? "Toronto, Ontario";
const total = String(stations.length - 1).padStart(2, "0");
---

<ExperienceLayout
  title={site.name}
  description={site.description}
>
  <a class="skip-link" href="/resume">Skip to text resume</a>
  <div class="experience" data-experience data-state="loading">
    <canvas
      class="experience-canvas"
      data-experience-canvas
      aria-hidden="true"
    ></canvas>
    <div class="experience-vignette" aria-hidden="true"></div>

    <header class="experience-hud">
      <a class="experience-brand" href="/" aria-label={`${site.name} — home`}>
        <span class="brand-name" aria-hidden="true">
          {
            [...site.name].map((letter, index) => (
              <span class="brand-letter" style={`--i:${index}`}>
                {letter === " " ? "\u00a0" : letter}
              </span>
            ))
          }
          <span class="brand-dot" aria-hidden="true"></span>
        </span>
        <span class="brand-role">Software Engineer · {location}</span>
      </a>
      <nav class="experience-links" aria-label="Site">
        <a href="/resume">Read as text</a>
        <a href="/domains">Domains</a>
        <button type="button" data-open-station="contact">Contact</button>
      </nav>
    </header>

    <div class="station-labels">
      {
        stations.map((station) => (
          <button
            class="station-label"
            type="button"
            data-station-label={station.id}
            aria-label={`Open ${station.label}`}
            aria-haspopup="dialog"
            aria-current="false"
            tabindex="-1"
          >
            <span class="station-label-index">
              {String(station.index).padStart(2, "0")}
            </span>
            <span>{station.label}</span>
          </button>
        ))
      }
    </div>

    <section class="experience-intro" aria-labelledby="intro-title">
      <p class="section-kicker">Interactive resume</p>
      <h1 id="intro-title">{site.name}</h1>
      <p class="intro-role">{role}</p>
      <p class="intro-copy">{resume.summary}</p>
      <div class="intro-actions">
        <button class="button" type="button" data-enter>
          Enter <span aria-hidden="true">→</span>
        </button>
        <a class="button-ghost" href="/resume">Read resume</a>
      </div>
      <p class="intro-hint">Drag to move · scroll to explore · click a node</p>
    </section>

    <div class="experience-loading" aria-live="polite">
      Growing the grove…
    </div>

    <nav class="station-map" aria-label="Resume stations">
      <span class="station-map-line" aria-hidden="true"></span>
      {
        stations.map((station) => (
          <button
            class="station-map-button"
            type="button"
            data-station-map={station.id}
            aria-label={`Open ${station.label}`}
            aria-current="false"
          >
            <span class="station-map-dot" aria-hidden="true"></span>
            <span class="station-map-name">{station.label}</span>
          </button>
        ))
      }
    </nav>

    <StationDialog resume={resume} />

    <div class="experience-tour" data-tour>
      <div
        class="experience-tour-progress"
        data-tour-progress
        role="progressbar"
        aria-label="Time until the next resume station"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="100"
      >
        <div class="experience-tour-track" aria-hidden="true">
          <span class="experience-tour-bar" data-tour-bar></span>
        </div>
        <span class="experience-tour-countdown" data-tour-countdown aria-hidden="true">
          Next in 8s
        </span>
      </div>

      <div class="experience-controls" role="group" aria-label="Tour controls">
        <button
          class="experience-control"
          type="button"
          data-auto
          aria-pressed="false"
          aria-label="Start auto tour"
        >
          <span class="experience-control-icon" data-auto-icon aria-hidden="true">▶</span>
          <span data-auto-label>Auto</span>
        </button>
        <button
          class="experience-control"
          type="button"
          data-next-node
          aria-label="Go to the next resume node"
        >
          Next <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <footer class="experience-footer">
      <p class="experience-progress">
        <span data-station-count>00 / {total}</span>
        <span>Interactive resume</span>
      </p>
      <p class="experience-hint">Drag · scroll · WASD</p>
      <p class="experience-meta">
        <a href="/resume">Full resume</a>
        <a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
    </footer>

    <section class="experience-fallback" aria-labelledby="fallback-title">
      <p class="section-kicker">Interactive resume unavailable</p>
      <h1 id="fallback-title">{site.name}</h1>
      <p>{resume.summary}</p>
      <div class="intro-actions">
        <a class="button" href="/resume">Read the full resume</a>
        <a class="button-ghost" href={`mailto:${resume.contact.email}`}>Email</a>
      </div>
    </section>

    <p class="sr-only" data-live aria-live="polite"></p>

    <noscript>
      <section class="experience-fallback experience-fallback-noscript">
        <p class="section-kicker">Resume</p>
        <h1>{site.name}</h1>
        <p>{resume.summary}</p>
        <p><a class="button" href="/resume">Read the full resume</a></p>
      </section>
    </noscript>
  </div>

  <script>
    import "../experience/main";
  </script>
</ExperienceLayout>
