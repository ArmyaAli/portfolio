---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Resume"
  description="Ali Umar's resume — software engineer working on realtime web and self-hosted infrastructure."
>
  <header class="page-header">
    <p class="section-kicker">Resume</p>
    <h1 class="page-title">Ali Umar</h1>
    <p class="page-lede">
      Software engineer working on realtime web, browser-first products, and the
      infrastructure behind them.
    </p>
    <div class="page-actions">
      <a class="button" href="/resume.pdf" download>
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </div>
  </header>

  <div class="pdf-frame">
    <iframe
      src="/resume.pdf#view=FitH"
      title="Ali Umar's resume (PDF)"
      loading="lazy"
    ></iframe>
  </div>
  <p class="page-note">
    Preview not loading?{" "}
    <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">
      Open the PDF in a new tab
    </a>
    .
  </p>
</BaseLayout>
