---
import { site } from "../config";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = site.ogImage,
  noindex = false,
} = Astro.props;
const pageTitle = title === site.name ? site.title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL(image, site.url);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  image: ogImage.href,
  sameAs: [site.links.github, site.links.linkedin],
  jobTitle: "Software Engineer",
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f4f0e8" data-theme-color />
<script is:inline>
  (() => {
    let stored = null;
    try {
      stored = localStorage.getItem("portfolio-theme");
    } catch {
      // Private contexts may block storage.
    }
    const theme =
      stored === "light" || stored === "dark"
        ? stored
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
    document.documentElement.dataset.theme = theme;
    const meta = document.querySelector("meta[data-theme-color]");
    if (meta) meta.setAttribute("content", theme === "dark" ? "#171310" : "#f4f0e8");
  })();
</script>

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`Portrait of ${site.name}`} />
<meta property="og:locale" content="en_CA" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
